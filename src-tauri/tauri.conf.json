{
  "productName": "jominy",
  "version": "1.0.0",
  "identifier": "com.huibosa.jominy",
  "build": {
    "frontendDist": "../webapp/frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../webapp/frontend && bun run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../webapp/backend/dist/main": "backend"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQTRCMjY1NTk2MjRDNTMKUldSVFRHSlpaYktrbXZsSHo5QkhKcnIyWlYvY1ZYdmJqY1E0Ym9STm9xTWNmNVc4YTNDUS84bUEK",
      "endpoints": [
        "https://github.com/huibosa/jominy/releases/latest/download/latest.json"
      ]
    }
  }
}
